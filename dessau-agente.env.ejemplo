# =============================================================================
#  Configuracion del agente de monitoreo (fork Dessau de RustDesk)
# -----------------------------------------------------------------------------
#  Estas claves las lee src/monitoreo.rs EN CADA PC. Orden de lectura:
#    1) archivo  %ProgramData%\Dessau\monitoreo\config   (mismo formato KEY=VALUE)
#    2) variables de entorno (fallback)
#  El instalador debe escribir el ARCHIVO con ACL solo Administrators+SYSTEM
#  (icacls, quitando el grupo Users): el secreto NO debe quedar world-readable.
#
#  NADA de esto va dentro del binario ni del codigo publicado (AGPL): es config.
#  Si falta DESSAU_MONITOREO_URL, el agente queda INERTE (no reporta nada).
# =============================================================================

# Endpoint de Gestion Dessau (edge function de Supabase, NO Gauzy :3800).
# Es la MISMA URL en cualquier red; el equipo se identifica por hostname + IP.
DESSAU_MONITOREO_URL=https://pwjlxoladntvlnzhnqyi.supabase.co/functions/v1/monitoreo-actividad-device

# Secreto de dispositivo (header x-device-secret). DEBE ser exactamente el valor
# de la tabla monitoreo_device_auth (id=1) del proyecto, o la edge responde 401.
# Generar/rotar aparte; NUNCA committearlo.
DESSAU_MONITOREO_SECRET=

# Opcional: apikey (anon key) por si la edge esta desplegada con verify_jwt=true.
# Si esta desplegada con verify_jwt=false (como monitoreo-captura-device), dejar vacio.
DESSAU_MONITOREO_APIKEY=

# Semilla del intervalo de envio en segundos (minimo 5; default 60). El SERVIDOR
# manda: tras el primer latido, muestreo/envio/idle los define Admin -> Monitoreo.
DESSAU_MONITOREO_INTERVALO=60
