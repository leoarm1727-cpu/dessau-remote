# =============================================================================
#  Configuracion del agente de monitoreo (fork Dessau de RustDesk)
# -----------------------------------------------------------------------------
#  Estas variables las lee src/monitoreo.rs EN CADA PC (por entorno del proceso).
#  NO van dentro del binario ni del codigo publicado (AGPL): son configuracion.
#
#  Como se aplican en cada PC (una de estas):
#   - Variables de entorno de la maquina (setx /M), o
#   - El instalador las escribe antes de arrancar el servicio de RustDesk.
#
#  Si falta DESSAU_MONITOREO_URL, el agente queda INERTE (no reporta nada).
# =============================================================================

# Endpoint HTTP donde el agente reporta la actividad. Segun la red de la PC:
#   Red 10.x (ej. US150):  http://192.168.10.251:3800/api/<endpoint-de-ingesta>
#   Red 0.x  (oficina):    http://192.168.0.10:3800/api/<endpoint-de-ingesta>
DESSAU_MONITOREO_URL=

# Secreto de dispositivo para autenticar el reporte (header x-device-secret).
# Generar uno fuerte y unico; NUNCA committearlo.
DESSAU_MONITOREO_SECRET=

# Segundos entre reportes (minimo 5; default 60 si se omite).
DESSAU_MONITOREO_INTERVALO=60
